# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EXTERNAL CRM & TRADING PORTAL CONFIGURATION
# These links redirect users from the public marketing site to your existing systems.
VITE_CRM_LOGIN_URL="https://portal.strataprimemarkets.com/login"
VITE_CRM_REGISTER_URL="https://portal.strataprimemarkets.com/register"
VITE_TRADING_TERMINAL_URL="https://trade.strataprimemarkets.com/terminal"

NEXT_PUBLIC_CRM_LOGIN_URL="https://portal.strataprimemarkets.com/login"
NEXT_PUBLIC_CRM_REGISTER_URL="https://portal.strataprimemarkets.com/register"
NEXT_PUBLIC_TRADING_TERMINAL_URL="https://trade.strataprimemarkets.com/terminal"
